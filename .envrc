# Turns on the pinned development shell (flake.nix) when Nix is installed.
# Harmless without Nix: every Nix-specific step below is guarded by `has nix`.
# See design.md D7 in openspec/changes/nix-dev-shell/ for the reasoning.

if has nix; then
  # Load nix-direnv if the contributor doesn't already have a recent enough
  # copy. The hash below was computed directly from this exact tagged
  # commit's content (not copied from nix-direnv's README, whose published
  # hash did not match when this was written) — see the verification
  # requirement in specs/dev-environment/spec.md.
  if ! has nix_direnv_version || ! nix_direnv_version 3.2.0; then
    source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.2.0/direnvrc" "sha256-hW6NC1JHue3IjZN3uDM6l6I2PMaauqd2D7hXYJ1Zfr4="
  fi

  # nix-direnv doesn't watch backend/rust-toolchain.toml or anything under
  # nix/ on its own. Watch them explicitly, so editing the Rust pin or a
  # module reloads the shell.
  watch_file backend/rust-toolchain.toml
  watch_file nix/*

  use flake
fi

# A contributor's own settings, loaded last so they win over the shell
# above. Git ignores this file; it never exists unless a contributor
# creates it. Works with or without Nix.
source_env_if_exists .envrc.local
