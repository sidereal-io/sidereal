# Settings for the Sidereal Compose instance.
# Copy this file to .env, then fill it in. See docs/install.md.

# Bundled mode only. The password must hold only letters and digits.
# Generate one with: openssl rand -hex 32
# PostgreSQL reads it only on the first start. Changing it later does not
# change the database's password.
POSTGRES_PASSWORD=

# The host port the app listens on.
SIDEREAL_PORT=5000

# Optional instance name. Use a new name for a fresh external installation,
# so it cannot adopt another installation's managed-storage volume.
#COMPOSE_PROJECT_NAME=sidereal-external

# External mode only. Select the app-only entry and supply a dedicated database.
# Exported shell variables override this file. Percent-encode URL credentials;
# single quotes keep dollar signs literal. Never commit a real connection URL.
#COMPOSE_FILE=compose.external-db.yml
#DATABASE_URL='postgres://sidereal:encoded-password@postgres.example.net:5432/sidereal?sslmode=verify-full'

# Optional. Keep data in host directories instead of Docker volumes.
# See "Choose where your data lives" in docs/install.md. Each directory
# must already exist; Compose never creates it. Select each override you
# use in COMPOSE_FILE. On Windows, separate the files with ; not :.
#COMPOSE_FILE=compose.yml:compose.storage-bind.yml:compose.database-bind.yml
#SIDEREAL_STORAGE_PATH=/mnt/photos/sidereal-storage
#SIDEREAL_DATABASE_PATH=/srv/sidereal-database

# Optional database certificates for external mode. Append
# compose.database-tls.yml to COMPOSE_FILE. The existing dedicated directory
# mounts read-only at /etc/sidereal/postgres. Name container paths with
# sslrootcert, sslcert, and sslkey in DATABASE_URL. Files must be readable by
# the app's UID/GID 10001:10001. See docs/install.md for private-key access.
#SIDEREAL_DATABASE_TLS_PATH=/srv/sidereal-database-tls
