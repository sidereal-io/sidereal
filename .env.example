# Settings for the Sidereal Compose instance.
# Copy this file to .env, then fill it in. See docs/install.md.

# Required. The database password. It must hold only letters and digits.
# Generate one with: openssl rand -hex 32
# PostgreSQL reads it only on the first start. Changing it later does not
# change the database's password.
POSTGRES_PASSWORD=

# The host port the app listens on.
SIDEREAL_PORT=5000

# Optional. Keep data in host directories instead of Docker volumes.
# See "Choose where your data lives" in docs/install.md. Each directory
# must already exist; Compose never creates it. Select each override you
# use in COMPOSE_FILE. On Windows, separate the files with ; not :.
#COMPOSE_FILE=compose.yml:compose.storage-bind.yml:compose.database-bind.yml
#SIDEREAL_STORAGE_PATH=/mnt/photos/sidereal-storage
#SIDEREAL_DATABASE_PATH=/srv/sidereal-database
